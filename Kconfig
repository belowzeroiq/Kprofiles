# Kprofiles configuration

config KPROFILES
	tristate "Kprofiles Kernel Module"
	default y
	help
	  Kprofiles provides a profile-oriented framework for regulating kernel
	  activities and optimizing system behavior based on usage patterns.
	  
	  It creates a sysfs interface (/sys/kernel/kprofiles/) for managing
	  four distinct profile modes:
	  
	  - Mode 0 (Disabled): Kprofiles is inactive
	  - Mode 1 (Battery): Optimized for power saving
	  - Mode 2 (Balanced): Balance between performance and battery life
	  - Mode 3 (Performance): Optimized for maximum performance
	  
	  Kernel developers can use the exported API functions to adjust kernel
	  features dynamically based on the active profile mode. This allows for
	  fine-grained control over CPU frequencies, I/O scheduling, memory
	  management, and other kernel subsystems.
	  
	  The module has minimal overhead and is only active when developers
	  explicitly use the API functions in other drivers.
	  
	  For detailed documentation and usage examples, visit:
	  https://github.com/beakthoven/Kprofiles
	  
	  If unsure, say Y.

if KPROFILES

config KP_DEFAULT_MODE
	int "Default profile mode at boot"
	range 0 3
	default 0
	help
	  Specify which profile mode Kprofiles should activate during system
	  boot. Valid values are:
	  
	  0 = Disabled (default)
	  1 = Battery
	  2 = Balanced
	  3 = Performance
	  
	  This mode can be changed at runtime via sysfs or kernel APIs.
	  Most users should leave this at 0 (Disabled) and let userspace
	  tools manage the profile mode based on system state.

config AUTO_KPROFILES
	bool
	help
	  Internal option automatically selected when any Auto Kprofiles
	  backend is enabled. Do not select this manually.

choice
	prompt "Auto Kprofiles backend"
	default AUTO_KPROFILES_NONE
	help
	  Auto Kprofiles automatically switches the profile mode based on
	  screen state using kernel notifier chains:
	  
	  - Screen OFF: Switches to Battery mode (mode 1)
	  - Screen ON:  Restores previously active mode
	  
	  Select the appropriate notifier backend for your platform. Most
	  devices use MSM DRM for display management. If your kernel doesn't
	  support display notifiers or you prefer manual control, select None.
	  
	  Note: Automatic mode switching can be enabled/disabled at runtime
	  via the /sys/kernel/kprofiles/auto_kp sysfs node.

config AUTO_KPROFILES_MSM_DRM
	bool "MSM DRM notifier (Qualcomm platforms)"
	depends on DRM_MSM
	select AUTO_KPROFILES
	help
	  Enable automatic profile mode switching using the MSM DRM notifier.
	  This is the recommended option for devices with Qualcomm SoCs that
	  use the MSM display driver.
	  
	  When enabled, Kprofiles will:
	  - Switch to Battery mode when the screen turns off
	  - Restore the previous mode when the screen turns on
	  
	  This helps conserve battery during screen-off periods while
	  maintaining performance when the device is actively used.

config AUTO_KPROFILES_MI_DRM
	bool "MI DRM notifier (Xiaomi platforms)"
	depends on !DRM_MSM
	select AUTO_KPROFILES
	help
	  Enable automatic profile mode switching using the MI DRM notifier.
	  Select this option for devices that use Xiaomi's MI DRM display
	  driver instead of the standard MSM DRM driver.
	  
	  Functionality is identical to MSM DRM notifier but uses Xiaomi's
	  proprietary notifier interface.

config AUTO_KPROFILES_FB
	bool "Framebuffer notifier (legacy)"
	depends on FB
	select AUTO_KPROFILES
	help
	  Enable automatic profile mode switching using the framebuffer
	  notifier API. This is a legacy option for older kernels or devices
	  that don't support DRM-based display management.
	  
	  Use this option only if your device doesn't support MSM DRM or
	  MI DRM notifiers.

config AUTO_KPROFILES_NONE
	bool "None (manual control only)"
	help
	  Disable automatic profile mode switching. Profile modes must be
	  changed manually via sysfs, kernel APIs, or userspace tools.
	  
	  This is the recommended option if:
	  - Your kernel doesn't support display notifiers
	  - You want complete manual control over profile modes
	  - You're implementing custom profile management logic
	  
	  Auto Kprofiles can still be enabled at runtime via the auto_kp
	  sysfs node if a compatible notifier backend is available.

endchoice

config KP_VERBOSE_DEBUG
	bool "Verbose debugging output"
	default n
	help
	  Enable detailed debug logging for Kprofiles operations. This will
	  output additional information to the kernel log, including:
	  
	  - Mode change events and transitions
	  - Screen state changes
	  - API function calls
	  - Error conditions and validations
	  
	  This option is useful for:
	  - Testing and debugging Kprofiles functionality
	  - Diagnosing integration issues with other kernel modules
	  - Understanding profile mode behavior
	  
	  Warning: This significantly increases kernel log verbosity.
	  Only enable this for development and debugging purposes.
	  
	  If unsure, say N.

endif # KPROFILES
